        function groupMarkersByDistance(markers, maxDistance) {

            const marker1 = markers[1];
            const groups = [];
            const processed = new Set();

            
            markers.forEach((marker, i) => {
                if (processed.has(i)) return;

                const group = [marker];
                processed.add(i);

                markers.forEach((otherMarker, j) => {
                    if (i !== j && !processed.has(j)) {
                        const distance = google.maps.geometry.spherical.computeDistanceBetween(
                            marker.getPosition(),
                            otherMarker.getPosition()
                        );

                        if (distance < maxDistance) {
                            group.push(otherMarker);
                            processed.add(j);
                        }
                    }
                });

                groups.push(group);
            });

            const representativeMarkers = groups.map(group => {
                const avgLat = group.reduce((sum, m) => sum + m.getPosition().lat(), 0) / group.length;
                const avgLng = group.reduce((sum, m) => sum + m.getPosition().lng(), 0) / group.length;

                 return new google.maps.Marker({
                    position: { lat: avgLat, lng: avgLng }, 
                    icon: marker1.getIcon(),
                    label: {
                    text: `${group.length}`,         
                    color: "red",                      
                    fontSize: "16px",                  
                    fontWeight: "bold"                 
                },
            map: map });
            });

            return representativeMarkers;
        }


           


