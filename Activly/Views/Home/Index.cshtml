    <script>

        function drawAllRoutes(map, routes) {
            const groupColors = {
                TrasaGrupa1: '#FF0000', 
                TrasaGrupa2: '#0000FF', 
            };

            for (const groupName in routes) {
                const group = routes[groupName];
                const color = groupColors[groupName] || getRandomColor(); 

                group.forEach(routeObj => {
                    for (const routeName in routeObj) {
                        const points = routeObj[routeName];

                        const routePath = points.map(point => new google.maps.LatLng(point.lat, point.lng));

                        const routeLine = new google.maps.Polyline({
                            path: routePath,
                            geodesic: true,
                            strokeColor: color,
                            strokeOpacity: 1.0,
                            strokeWeight: 2
                        });

                        routeLine.setMap(map);

                        new google.maps.Marker({
                            position: routePath[0],
                            map: map,
                            title: `${routeName} - Start`
                        });

                        new google.maps.Marker({
                            position: routePath[routePath.length - 1],
                            map: map,
                            title: `${routeName} - Koniec`
                        });
                    }
                });
            }
        }

        function getRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }




