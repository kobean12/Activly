        function processSurvey() {
            
            const experience = parseInt(experienceInput.value);
            const willingness = parseInt(willingnessInput.value);
            const sportswear = parseInt(sportswearInput.value);

            const totalScore = experience + willingness + sportswear;
            const dropdown = document.getElementById('dystanstrasyLevel');
            const howFarTrasa = parseInt(dystansdotrasyInput.value);
            let message = '';
            
            if(dropdown.value==5)
            {
                switch (true) {
                    case (totalScore <= 10):
                        message = 'Jesteś początkujący, zacznij od małych kroków!';
                               drawRoute(findNearestRoute5('TrasaGrupa1', user_location,howFarTrasa));
                        break;
                    case (totalScore <= 20):
                        message = 'Jesteś na dobrej drodze! Przygotuj się do regularnego biegania.';
                               drawRoute(findNearestRoute5('TrasaGrupa2', user_location,howFarTrasa));
                        break;
                    case (totalScore > 20):
                        message = 'Jesteś świetnie przygotowany! Czas na wyzwania.';
                        drawRoute(findNearestRoute5('TrasaGrupa3', user_location,howFarTrasa));
                        break;
                    default:
                        message = 'Wprowadź poprawne wartości.';
