<body>
    
     <div id="buttonBlock" class="button-container" style="display:block;"> <!-- Guziki admina display:block-->
        <button id="markingModeButton">Marking Mode</button>
        <button id="savePointsButton">Save Points</button>
        <button id="toggleHeatmap">Toggle Heatmap</button>
        <button id="drawCirclesButton">Draw Circles</button>
        <button id="drawTrasyButton">Draw Trasy</button>
    </div>


    <link id="theme-stylesheet" rel="stylesheet" href="/css/style.css">

    

    <div class="modal" id="mainModal">
        <div class="modal-content">
            <span class="close" id="closeMainModal">&times;</span>
            <h2>Wiadomości</h2>
            <div id="messageContainer"></div>
        </div>
    </div>


    <div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="userProfileModalLabel">Profil użytkownika</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="modalGender" class="form-label">Gender:</label>
                        <input type="text" id="modalGender" class="form-control" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="modalAge" class="form-label">Age:</label>
                        <input type="text" id="modalAge" class="form-control" readonly>
                    </div>
                    <div class="text-center">
                        <label class="form-label d-block">Avatar:</label>
                        <img id="modalAvatar" src="" alt="Avatar" style="max-width: 100px; height: auto;">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <style>
        #modalGender {
            color: black; 
            font-weight: bold; 
        }

        #modalAge {
            color: green; 
            font-style: italic; 
        }
        #userProfileModal {
            z-index: 1065 !important; 
        }
    </style>

    <div id="promptModal" class="modal">
        <div class="modal-content">
            <h4>Podaj szczegóły aktywności</h4>

            <label id= "activitySelect"for="activityName">Wybierz Aktywność:</label>
            <select id="activityName">
                <option id="Kosz" value="Koszykowka">Koszykowka</option>
                <option id="Noga" value="Pilka_nozna">Piłka nożna</option>
                <option id="Bieg" value="Bieganie">Bieganie</option>
                <option id="Inne" value="Inne">Inne</option>
            </select>

            <label for="activityDate">Data (DD:MM:YYYY):</label>
            <input type="date" id="activityDate" value="2024-12-01" />

            <label id="czaslabel"for="activityTime">Czas (HH:MM):</label>
            <input type="time" id="activityTime" value="12:00">

            <button id="confirmBtn">Zatwierdź</button>
            <button id="closeModalBtn">Anuluj</button>
        </div>
    </div>
    
    <div id="alertModal" class="modal">
        <div class="modal-content">
            <h4>Wybierz godzinę i aktywność</h4>
        
