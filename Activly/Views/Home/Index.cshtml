        function findNearestRoute10(groupName, startLocation,howFar) {
            const group = routes10[groupName];

            if (!group) {
                throw new Error(`Grupa "${groupName}" nie istnieje.`);
            }

            let nearestRoute = null;
            let shortestDistance =  100;
            let nearestRoutePoints = [];

            group.forEach((route) => {
                for (const routeName in route) {
                    const points = route[routeName];
                    const firstPoint = points[0];
                    const distance = getDistanceInKm(startLocation.lat, startLocation.lng, firstPoint.lat, firstPoint.lng);
                    if(distance >howFar)
                    {
                        return;
                    }
                    if (distance < shortestDistance) {
                        shortestDistance = distance;
                        nearestRoute = { routeName, distance };
                        nearestRoutePoints = points;
                    }
                }
            });

            return nearestRoutePoints ;
        }

        function findNearestRoute5(groupName, startLocation, howFar) {
            const group = routes5[groupName];

            if (!group) {
                throw new Error(`Grupa "${groupName}" nie istnieje.`);
            }

            let nearestRoute = null;
            let shortestDistance = 100;
            let nearestRoutePoints = [];

            group.forEach((route) => {
                for (const routeName in route) {
                    const points = route[routeName]; 
                    const firstPoint = points[0]; 
                    const distance = getDistanceInKm(startLocation.lat, startLocation.lng, firstPoint.lat, firstPoint.lng);

                    if(distance >howFar)
                    {
                        return;
                    }

                    if (distance < shortestDistance) {
                        shortestDistance = distance;
                        nearestRoute = { routeName, distance };
                        nearestRoutePoints = points;
                    }
                }
            });

            return nearestRoutePoints ;
        }

