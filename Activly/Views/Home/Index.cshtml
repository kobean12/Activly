            function isMarkerInArray(array, marker) {
            return array.some(existingMarker => {

                const existingPos = existingMarker.getPosition();
                const newPos = marker.getPosition();

                return (
                    existingPos.lat() === newPos.lat() &&
                    existingPos.lng() === newPos.lng() &&
                    existingMarker.activity === marker.activity &&
                    existingMarker.author === marker.author
                );
            });
        }
